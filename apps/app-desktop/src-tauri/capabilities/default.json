{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "shell:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
